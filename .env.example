# ===== TikTok app (developers.tiktok.com → app của bạn) =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Phải khớp CHÍNH XÁC với Redirect URI khai báo trong Login Kit.
# Khuyên dùng callback Worker (callback-worker/): https://tiktok-callback.<tên>.workers.dev/callback
# (http://localhost:3455/callback chỉ dùng được với app loại Desktop)
TIKTOK_REDIRECT_URI=https://tiktok-callback.example.workers.dev/callback

# PKCE: bắt buộc với app loại Desktop (thiếu sẽ báo lỗi "code_challenge"). Để 1.
TIKTOK_USE_PKCE=1

# Chỉ ghi các scope đã bật cho app (thiếu cái nào TikTok báo lỗi "scope").
# video.publish chỉ có khi bật Direct Post; không có thì video được gửi vào hộp nháp TikTok.
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.list,video.upload

# ===== Đăng bài =====
# SELF_ONLY bắt buộc với app chưa được TikTok duyệt.
# PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
DEFAULT_PRIVACY=SELF_ONLY
# direct = đăng thẳng (cần video.publish), inbox = gửi vào hộp nháp TikTok
DEFAULT_MODE=direct

# ===== Web app quản lý (npm start) =====
PORT=8787
# 127.0.0.1 = chỉ máy này truy cập. Đặt 0.0.0.0 để vào từ điện thoại/máy khác cùng mạng
HOST=127.0.0.1
# Nên đặt khi HOST=0.0.0.0: trình duyệt sẽ hỏi mật khẩu (user nhập gì cũng được)
# ADMIN_PASSWORD=
# Nơi lưu hàng chờ (pending/), cài đặt (settings.json) và nhật ký (logs/YYYY-MM-DD.txt)
DATA_DIR=./data

# ===== CLI queue/watch =====
QUEUE_DIR=./queue
WATCH_INTERVAL_MIN=60
