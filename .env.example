# ===== Web app quản lý (npm start) =====
PORT=8787
# 127.0.0.1 = chỉ máy này truy cập. Đặt 0.0.0.0 để vào từ điện thoại/máy khác cùng mạng
HOST=127.0.0.1
# Nên đặt khi HOST=0.0.0.0: trình duyệt sẽ hỏi mật khẩu (user nhập gì cũng được)
# ADMIN_PASSWORD=
# Nơi lưu video đã tải lên và dữ liệu (db.json)
DATA_DIR=./data

# ===== Cách upload =====
# browser = điều khiển trình duyệt, KHÔNG cần key (mặc định)
# api     = Content Posting API chính thức, cần client key/secret bên dưới
UPLOAD_METHOD=browser

# Chế độ browser: 1 = chạy ẩn (TikTok hay chặn headless, nên để 0)
HEADLESS=0
# Trình duyệt tool tự mở: chromium (mặc định) | brave (tự tìm Brave đã cài)
TIKTOK_BROWSER=chromium
# Hoặc chỉ đường dẫn cụ thể tới file chạy của trình duyệt (ưu tiên hơn TIKTOK_BROWSER)
# CHROMIUM_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Mở tab trong Brave/Chrome bạn ĐANG MỞ SẴN thay vì mở trình duyệt mới.
# Brave phải được mở với --remote-debugging-port=9222 (xem README).
# BROWSER_CDP_URL=http://127.0.0.1:9222

# ===== Chỉ cần khi UPLOAD_METHOD=api =====
# Lấy từ https://developers.tiktok.com/apps -> app của bạn
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Phải khớp CHÍNH XÁC với Redirect URI đã đăng ký trong app TikTok.
# Nếu là http://localhost:<port>/... tool sẽ tự mở server để bắt code.
# Nếu là URL https khác, tool sẽ yêu cầu bạn dán URL sau khi đăng nhập.
TIKTOK_REDIRECT_URI=http://localhost:3455/callback

# Bật (1) nếu app đăng ký dạng Desktop (TikTok yêu cầu PKCE cho desktop)
TIKTOK_USE_PKCE=0

TIKTOK_SCOPES=user.info.basic,video.publish,video.upload

# SELF_ONLY bắt buộc với app chưa được TikTok audit.
# Các giá trị: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | FOLLOWER_OF_CREATOR | SELF_ONLY
DEFAULT_PRIVACY=SELF_ONLY

# direct = đăng thẳng (scope video.publish), inbox = gửi vào nháp TikTok (scope video.upload)
DEFAULT_MODE=direct

QUEUE_DIR=./queue
WATCH_INTERVAL_MIN=60
